# Aegis-Proxy-Stack .gitignore

# 1. Runtime Data & Logs
aegis-data/
aegis-logs/
/backups/

# 2. Runtime Config
aegis-config/agent/
aegis-config/policy/local_policy.yaml

# 3. npm files generated by the install and verification scripts
node_modules/
/package.json
/package-lock.json
/aegis-config/scripts/package.json
/aegis-config/scripts/package-lock.json

# 4. System Files
.env
.DS_Store
Thumbs.db
VERSION
