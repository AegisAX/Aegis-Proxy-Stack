+// Local to the NGINX adapter. Keep the HTTP manager's public verdict ABI unchanged.
+class WafInspectionResult : public FilterVerdict
+{
+public:
+    using FilterVerdict::FilterVerdict;
+    WafInspectionResult(const FilterVerdict &value) : FilterVerdict(value) {}
+
+    static WafInspectionResult unavailable(ServiceVerdict fallback)
+    {
+        WafInspectionResult value(fallback);
+        value.inspection_unavailable = true;
+        return value;
+    }
+
+    bool unavailable() const { return inspection_unavailable; }
+
+private:
+    bool inspection_unavailable = false;
+};
