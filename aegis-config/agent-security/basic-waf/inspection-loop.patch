+    // BIO's nonblocking socket flag does not apply to its initial DNS lookup.
+    // Background HTTP integrations must not stall the handler that inspects requests.
+    BioConnectionStatus
+    startLocalHttpConnection(const string &address, I_MainLoop *loop, I_TimeGet *clock, chrono::microseconds deadline)
+    {
+        static atomic<unsigned> pending{0};
+        if (pending.fetch_add(1) >= 4) {
+            --pending;
+            return BioConnectionStatus::SHOULD_NOT_RETRY;
+        }
+
+        using Result = pair<BioUniquePtr<BIO>, BioConnectionStatus>;
+        future<Result> result;
+        try {
+            packaged_task<Result()> start([address] {
+                auto release_slot = make_scope_exit([] { --pending; });
+                BioUniquePtr<BIO> socket(BIO_new(BIO_s_connect()));
+                auto status = BioConnectionStatus::SHOULD_NOT_RETRY;
+                if (socket && BIO_set_conn_hostname(socket.get(), address.c_str()) > 0 &&
+                    BIO_set_nbio(socket.get(), 1) > 0) {
+                    if (BIO_do_connect(socket.get()) > 0) status = BioConnectionStatus::SUCCESS;
+                    else if (BIO_should_retry(socket.get())) status = BioConnectionStatus::SHOULD_RETRY;
+                }
+                return Result(move(socket), status);
+            });
+            result = start.get_future();
+            thread(move(start)).detach();
+        } catch (const system_error &) {
+            --pending;
+            return BioConnectionStatus::SHOULD_NOT_RETRY;
+        }
+        // packaged_task owns the private BIO. A timeout or coroutine cancellation
+        // releases this caller without joining the resolver or touching its socket.
+        while (result.wait_for(chrono::seconds(0)) != future_status::ready) {
+            if (clock->getMonotonicTime() >= deadline) return BioConnectionStatus::SHOULD_NOT_RETRY;
+            loop->yield(chrono::milliseconds(2));
+        }
+        auto connected = result.get();
+        if (connected.second != BioConnectionStatus::SHOULD_NOT_RETRY) bio = move(connected.first);
+        return connected.second;
+    }
