ARG PARENT
FROM ${PARENT}
LABEL io.aegis.waf.scope="1"
COPY waf-scope.cjs /app/aegis-waf-scope.cjs
COPY aegis-waf.js /app/internal/aegis-waf.js
RUN test "$(grep -cx 'http {' /etc/nginx/nginx.conf)" = 1 && sed -i '/^http {/a\    include /run/nginx/aegis-waf-scope.conf;' /etc/nginx/nginx.conf && \
    test "$(grep -c '^exec s6-setuidgid ' /etc/s6-overlay/s6-rc.d/nginx/run)" = 1 && \
    sed -i '/^exec s6-setuidgid /i s6-setuidgid "$PUID:$PGID" node /app/aegis-waf-scope.cjs startup' /etc/s6-overlay/s6-rc.d/nginx/run && \
    mkdir -p /etc/s6-overlay/s6-rc.d/aegis-waf-scope/dependencies.d && \
    printf '%s\n' longrun > /etc/s6-overlay/s6-rc.d/aegis-waf-scope/type && \
    printf '%s\n' '#!/command/with-contenv bash' 'set -e' '. /usr/bin/common.sh' 'exec s6-setuidgid "$PUID:$PGID" node /app/aegis-waf-scope.cjs watch' >/etc/s6-overlay/s6-rc.d/aegis-waf-scope/run && \
    chmod 755 /etc/s6-overlay/s6-rc.d/aegis-waf-scope/run && \
    touch /etc/s6-overlay/s6-rc.d/aegis-waf-scope/dependencies.d/nginx /etc/s6-overlay/s6-rc.d/user/contents.d/aegis-waf-scope
